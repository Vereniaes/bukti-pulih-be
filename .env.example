# Backend settings. Copy values into the local environment, not source code.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/buktipulih_db
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Request this key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Cloud Scheduler OIDC. Leave unset until the production target is configured.
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=

# Official ISPU upstream authorization, supplied to the backend only.
ISPU_AUTHORIZATION=

# Fifteen-minute satellite sync OIDC. Independent from the legacy BNPB/CAMS job.
SATELLITE_SCHEDULER_AUDIENCE=
SATELLITE_SCHEDULER_SERVICE_ACCOUNT=

# Existing auth secrets - set private values; never use development defaults in production.
JWT_SECRET=
COOKIE_SECRET=


# Email OTP - fill privately before real email testing.
# Fill privately before local OTP testing; use separate production values.
BREVO_API_KEY=
AUTH_OTP_PEPPER=
BREVO_SENDER_EMAIL=yuangjin199@gmail.com
BREVO_SENDER_NAME=BuktiPulihDoNotReply

# Open place search; switch to a hosted/self-managed Photon for larger traffic.
PHOTON_BASE_URL=https://photon.komoot.io
